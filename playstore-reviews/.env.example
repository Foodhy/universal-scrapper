# Opcional. Una URL o varias separadas por coma.
# Pisa la lista proxies del YAML. No subas este archivo con credenciales.
# Ejemplo: http://user:pass@host:8080,http://host2:8080
PLAYSTORE_PROXIES=

# Clasificación con Jev (OpenRouter Decisions API). El panel no pide esta clave.
# https://openrouter.ai/typesafe/jev-1.13
OPENROUTER_API_KEY=
